# Copie para `.env` e preencha. O `.env` está no .gitignore: nunca o commite.

# Endereço-base da API. O mesmo para homologação e produção: quem decide o ambiente é a credencial.
FLEXDFE_URL=https://flexdfe.com.br

# Credencial de GESTÃO (escopo de integrador): cadastra o emitente, sobe o certificado e cunha a
# credencial operacional. Ela NÃO emite. Gere no painel, em Credenciais & Webhooks, sem escolher emitente.
FLEXDFE_CLIENT_ID=
FLEXDFE_SECRET=

# Certificado A1 do CNPJ que vai emitir, e a senha dele. O arquivo vai para a API em base64,
# uma única vez, e nunca volta. Não commite o .pfx.
CERTIFICADO_PFX=./certificado.pfx
CERTIFICADO_SENHA=

# Onde a aplicação guarda o que aprendeu (id do emitente, credencial operacional, cursor do feed).
# Fica em claro, na sua máquina. Não commite.
BANCO=./exemplo.sqlite

# Porta da tela local.
PORTA=3080
